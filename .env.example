# ─────────────────────────────────────────────────────────────
# Rzs media — переменные окружения
# Скопируйте файл в .env.local и заполните значения.
# Все переменные НЕОБЯЗАТЕЛЬНЫ: без них сайт работает в демо-режиме.
# ─────────────────────────────────────────────────────────────

# ── Режим сайта ──────────────────────────────────────────────
# ВАЖНО: режим задаётся НЕ здесь, а полем "mode" в content/business.json
#   "mode": "demo"        — сайт закрыт от индексации, заявки уходят в WhatsApp
#   "mode": "production"  — индексация открыта, заявки уходят в Telegram
# Одна переменная управляет всем сразу: метатеги, X-Robots-Tag, robots.txt,
# sitemap, плашка «Демо-концепт» и строка в футере.

# Публичный адрес сайта. Нужен для canonical, sitemap, Open Graph.
# Локально: http://localhost:3000
# На Vercel: https://rzs-media.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Приём заявок (боевой режим) ──────────────────────────────
# Токен бота Telegram: получите у @BotFather командой /newbot
# TELEGRAM_BOT_TOKEN=123456789:AAaaBBccDDeeFFggHHiiJJkkLLmmNNooPP
# ID чата владельца, куда падают заявки: получить у @getmyid_bot
# TELEGRAM_CHAT_ID=123456789
# Необязательно: имя бота-отправителя для текста сообщения
# TELEGRAM_SENDER_NAME=rzs_media

# ── Аналитика (подключается только при наличии ID) ───────────
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_YM_ID=12345678

# ── Согласие на обработку персональных данных ────────────────
# Оператор данных, указывается на странице /privacy
NEXT_PUBLIC_DATA_OPERATOR=Rzs media
